{
  "name": "boau-code",
  "productName": "Relay Workbench",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "description": "A local desktop workbench for coding agents",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node tools/build.cjs",
    "start": "electron .",
    "export:source": "node tools/export-source.cjs",
    "package:win": "node tools/package.cjs",
    "setup:claude": "node tools/setup-claude.cjs",
    "check:build": "node tools/check-build.cjs",
    "test:e2e": "node tools/smoke-core.cjs && node tools/smoke-agents.cjs && node tools/smoke-workbench.cjs && node tools/smoke.cjs && node tools/smoke-login.cjs && node tools/check-editor-tabs.cjs",
    "installer:win": "node tools/build-installer.cjs",
    "website:serve": "node tools/serve-website.cjs",
    "website:check": "node tools/check-website.cjs",
    "release:metadata": "node tools/release-metadata.cjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "diff": "9.0.0",
    "fast-glob": "3.3.3",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  },
  "author": "Relay Workbench contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/huxhkuh/relay-workbench.git"
  },
  "homepage": "https://huxhkuh.github.io/relay-workbench/",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
